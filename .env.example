# Copy to .env, fill local credentials, and keep .env out of Git.
# setup-local.ps1 generates this file for the existing local_postgres container.
# Select the dev profile in the run command shown in README.
DB_URL=jdbc:postgresql://localhost:5432/documind
DB_USERNAME=documind
DB_PASSWORD=
DB_MIGRATION_USERNAME=postgres
DB_MIGRATION_PASSWORD=
TEST_DB_URL=jdbc:postgresql://localhost:5432/documind_phase1_test
TEST_DB_USERNAME=documind
TEST_DB_PASSWORD=
TEST_DB_MIGRATION_USERNAME=postgres
TEST_DB_MIGRATION_PASSWORD=
SERVER_PORT=8080
# Base64 encoding of >=32 random bytes. Generate with deploy/setup-auth-local.ps1.
JWT_SECRET=
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Successful uploads per account per sliding window (in-memory, one instance).
UPLOAD_MAX_PER_WINDOW=10
UPLOAD_WINDOW_SECONDS=60
# Optional: used only when the Gemini embedding adapter is explicitly enabled.
GEMINI_API_KEY=
# Advanced retrieval stays disabled until the evaluation demonstrates a benefit.
RETRIEVAL_HYBRID_ENABLED=false
RETRIEVAL_RERANK_ENABLED=false
# Keep enabled for release; false is only for evaluation ablation.
RETRIEVAL_REWRITE_ENABLED=true
# To opt in later, set these explicitly in .env after adding a key:
# documind.gemini.enabled=true
# documind.ingestion.pipeline-enabled=true
# documind.ingestion.worker-enabled=true
# Optional standalone Compose database (not used when reusing local_postgres):
POSTGRES_PASSWORD=
DOCUMIND_POSTGRES_PORT=5433
