# Copy to .env, fill local credentials, and keep .env out of Git.
# setup-local.ps1 generates this file for the existing local_postgres container.
# Select the dev profile in the run command shown in README.
DB_URL=jdbc:postgresql://localhost:5432/documind
DB_USERNAME=documind
DB_PASSWORD=
DB_MIGRATION_USERNAME=postgres
DB_MIGRATION_PASSWORD=
TEST_DB_URL=jdbc:postgresql://localhost:5432/documind_phase1_test
TEST_DB_USERNAME=documind
TEST_DB_PASSWORD=
TEST_DB_MIGRATION_USERNAME=postgres
TEST_DB_MIGRATION_PASSWORD=
SERVER_PORT=8080
# Spring AI is disabled in Phase 1. Do not add API keys until a provider is chosen.
# Optional standalone Compose database (not used when reusing local_postgres):
POSTGRES_PASSWORD=
DOCUMIND_POSTGRES_PORT=5433
